# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# iOS (Capacitor) — Xcode/CocoaPodsが再生成できるものはコミットしない。
# ios/App/App.xcworkspace・ios/App/App.xcodeproj・ios/App/App/ 配下のソース自体は
# 通常コミット対象（Capacitorの標準構成）。
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/**/xcuserdata/
ios/.build/
next-env.d.ts
